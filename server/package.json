{
  "name": "jyl-server",
  "version": "1.8.13",
  "description": "甲友乐后端服务 - 甲状腺健康管理平台",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:check": "node scripts/check-migrations.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm test && npm run audit:prod",
    "release:check": "node scripts/release-check.js",
    "app:update:publish": "node scripts/publish-app-update.js",
    "test": "node --test",
    "unlock:user": "node scripts/unlock-user.js",
    "reset:admin": "node scripts/reset-admin.js",
    "clean:indexes": "node scripts/clean-indexes.js"
  },
  "keywords": [
    "甲状腺",
    "健康管理",
    "koa",
    "nodejs"
  ],
  "author": "JYL Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.1",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^5.1.1",
    "koa-helmet": "^9.0.0",
    "koa-mount": "^4.2.0",
    "koa-ratelimit": "^6.0.0",
    "koa-router": "^14.0.0",
    "koa-static": "^5.0.0",
    "mysql2": "^3.16.2",
    "nodemailer": "^10.0.0",
    "sequelize": "^6.37.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.2"
  },
  "optionalDependencies": {
    "ioredis": "^5.6.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
